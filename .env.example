# Copy to .env.local and fill in values for local development.
# Required in every deployment environment (Vercel, etc.).

# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional alias supported by the app:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
# Server-only — account deletion API
SUPABASE_SERVICE_ROLE_KEY=

# ─── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Browser — event-detail Embed + listing/playgrounds Maps JS. Enable Maps JavaScript API
# (Embed alone is not enough for the listing map tab).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Server-only — Geocoding API + Places API (New). Never expose to the browser.
GOOGLE_MAPS_GEOCODING_API_KEY=
# Google Analytics Measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# ─── Smart Fill (server-side; keys never exposed to the browser) ─────────────
APIFY_TOKEN=
# Facebook events actor — either name works:
APIFY_FACEBOOK_EVENTS_ACTOR_ID=
# APIFY_ACTOR_ID=

GEMINI_API_KEY=

# Admin-only scraper tab + host-section hiding for admin-created events
ADMIN_USER_ID=
NEXT_PUBLIC_ADMIN_USER_ID=
